# Render / production variables - never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_CARD_PEPPER=replace-with-a-long-random-secret-at-least-32-characters
APP_BOOTSTRAP_ADMIN_EMAIL=library-admin@example.edu
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_DEFAULT_DUE_DAYS=14
